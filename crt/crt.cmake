# retro-native CRT: include(${RETRO_NATIVE_DIR}/crt/crt.cmake), then
#   target_link_libraries(<game> PRIVATE retro_crt)
# and in C++:  #include "crt.h"  #include "retro_crt_shaders.h"
# retro_crt_shaders.h defines const char *kRetroCrtVert, kRetroSharpFrag, kRetroCrtFrag.
if(TARGET retro_crt)
  return()  # include guard: already added by another include
endif()

get_filename_component(RETRO_CRT_DIR "${CMAKE_CURRENT_LIST_DIR}" ABSOLUTE)
set(RETRO_CRT_GEN_DIR "${CMAKE_BINARY_DIR}/generated/retro_crt")
set(RETRO_CRT_GEN_HEADER "${RETRO_CRT_GEN_DIR}/retro_crt_shaders.h")

set(_rc_content "// Generated by crt.cmake from retro-native/crt/*.vert|*.frag. Do not edit.\n#pragma once\n")
foreach(_pair "kRetroCrtVert:crt.vert" "kRetroSharpFrag:sharp.frag" "kRetroCrtFrag:crt.frag")
  string(REPLACE ":" ";" _pair_l "${_pair}")
  list(GET _pair_l 0 _sym)
  list(GET _pair_l 1 _file)
  set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${RETRO_CRT_DIR}/${_file}")
  file(READ "${RETRO_CRT_DIR}/${_file}" _src)
  string(APPEND _rc_content "static const char *const ${_sym} = R\"RETROGLSL(${_src})RETROGLSL\";\n")
endforeach()
# Only touch the file when the content changed (avoids needless rebuilds).
set(_rc_old "")
if(EXISTS "${RETRO_CRT_GEN_HEADER}")
  file(READ "${RETRO_CRT_GEN_HEADER}" _rc_old)
endif()
if(NOT "${_rc_old}" STREQUAL "${_rc_content}")
  file(WRITE "${RETRO_CRT_GEN_HEADER}" "${_rc_content}")
endif()

add_library(retro_crt STATIC "${RETRO_CRT_DIR}/crt.cpp")
target_include_directories(retro_crt PUBLIC "${RETRO_CRT_DIR}" "${RETRO_CRT_GEN_DIR}")
target_compile_features(retro_crt PUBLIC cxx_std_17)
if(NOT MSVC)
  target_compile_options(retro_crt PRIVATE -Wall -Wextra -Werror)
endif()
